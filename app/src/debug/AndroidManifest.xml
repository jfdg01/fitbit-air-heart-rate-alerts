<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Exported so that adb can reach it. The release build does not have it. -->
        <receiver
            android:name=".DemoBpmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nikashitsa.polar_alert_android.SET_BPM" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DemoPartnerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nikashitsa.polar_alert_android.SET_PARTNER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
